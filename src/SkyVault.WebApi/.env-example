# MySQL Configuration (Local Development)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=skyvault
MYSQL_USER=skyvault_user
MYSQL_PASSWORD=your_password

# Azure Database Configuration (Production with Managed Identity)
AZURE_DB_SERVER=your-server.mysql.database.azure.com
AZURE_DB_DATABASE=skyvault_prod
AZURE_CLIENT_ID=your-managed-identity-client-id

# ASP.NET Core Configuration
ASPNETCORE_ENVIRONMENT=
ASPNETCORE_CERT_PASSWORD=

# Azure AD Configuration
AZUREAD__INSTANCE=
AZUREAD__TENANTID=
AZUREAD__CLIENTID=
AZUREAD__AUDIENCE=

# CORS Configuration
CORS_ALLOWED_ORIGINS=

# Logging Configuration
LOGGING__FILEPATH=

# Authorization
AUTHORIZATION__APIKEY=

# Azure Application Insights (Optional)
AZUREAPPINSIGHT__INSTRUMENTKEY=

# Azure Function Base URL (Optional)
AZURE_FUNCTION_BASE_URL=

# Azure Key Vault (Production)
KEYVAULT_URI=https://your-keyvault-name.vault.azure.net/
