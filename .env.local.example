# Entra ID Configuration (from Bicep deployment)
AZUREAD__INSTANCE=https://login.microsoftonline.com/
AZUREAD__TENANTID=<get-from-bicep-output>
AZUREAD__CLIENTID=<get-from-bicep-output>
AZUREAD__CLIENTSECRET=<get-from-bicep-output>
AZUREAD__CALLBACKPATH=/signin-oidc

# Database
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=skyvault_dev
MYSQL_USER=skyvault_user
MYSQL_PASSWORD=skyvault_pass

# API
ASPNETCORE_ENVIRONMENT=Development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080